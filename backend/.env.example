# Choose "gemini" (free key from aistudio.google.com) or "ollama" (local, no key)
PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACKS=gemini-3.5-flash-lite
# OLLAMA_MODEL=qwen2.5-coder:7b
CHUNK_CHARS=6000
# Running code (executes on THIS machine; keep local)
ENABLE_RUN=true
RUN_TIMEOUT=10
AUTOFIX_MAX_CHARS=30000
